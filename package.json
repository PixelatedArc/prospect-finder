{
  "name": "prospect-finder",
  "productName": "Prospect Finder",
  "version": "1.0.0",
  "description": "Finds weak local-business websites from Google Maps and logs them to a Google Sheet",
  "main": "main.js",
  "author": "Devdwell",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.devdwell.prospectfinder",
    "productName": "Prospect Finder",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "engine/**/*", "apps-script/**/*", "src/**/*", "assets/**/*"],
    "win": {
      "icon": "assets/icon.png",
      "target": ["dir"]
    }
  }
}
